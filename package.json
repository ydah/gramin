{
  "name": "gramin-workspace",
  "version": "0.0.0",
  "author": "Yudai Takada",
  "description": "Grammar analysis packages and command-line tooling",
  "private": true,
  "license": "MIT",
  "homepage": "https://ydah.github.io/gramin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydah/gramin.git"
  },
  "bugs": {
    "url": "https://github.com/ydah/gramin/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.5",
      "nanoid": "3.3.17",
      "vite": "6.4.3"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && node packages/core/dist/write-schemas.js",
    "benchmark:corpus": "pnpm build && node scripts/benchmark-corpus.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:cross-format": "node scripts/update-cross-format-notes.mjs --check",
    "clean": "tsc -b --clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && pnpm check:boundaries",
    "release:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm benchmark:corpus && pnpm release:pack && pnpm release:smoke",
    "release:pack": "pnpm clean && pnpm build && node scripts/pack-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs",
    "site:build": "pnpm build && pnpm --filter @gramin/site build",
    "site:check": "pnpm build && pnpm --filter @gramin/site typecheck && pnpm --filter @gramin/site build && pnpm site:links",
    "site:links": "node scripts/check-site-links.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "update-golden": "pnpm build && node scripts/update-golden.mjs --update-golden"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
