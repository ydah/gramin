{
  "name": "gramin-workspace",
  "version": "0.0.0",
  "author": "Yudai Takada",
  "description": "Grammar analysis packages and command-line tooling",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/ydah/gramin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydah/gramin.git"
  },
  "bugs": {
    "url": "https://github.com/ydah/gramin/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && node packages/core/dist/write-schemas.js",
    "benchmark:corpus": "pnpm build && node scripts/benchmark-corpus.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "clean": "tsc -b --clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && pnpm check:boundaries",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "update-golden": "pnpm build && node scripts/update-golden.mjs --update-golden"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
