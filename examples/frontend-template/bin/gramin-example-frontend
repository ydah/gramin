#!/usr/bin/env python3
"""Replace parse_grammar with the parser for your grammar format."""

import argparse
import json
from pathlib import Path
import re
import sys


class ProtocolArguments(argparse.ArgumentParser):
    def error(self, message):
        self.exit(3, f"{self.prog}: {message}\n")


def parse_grammar(sources):
    decoder = json.JSONDecoder()
    rules, names, literals = [], set(), set()
    for _, content in sources:
        for line_number, line in enumerate(content.splitlines(), 1):
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            match = re.fullmatch(r"\s*([A-Za-z_][A-Za-z0-9_]*)\s*::=\s*(.*)", line)
            if not match:
                raise ValueError(f"expected a literal-alternative rule on line {line_number}")
            name, remaining = match.groups()
            if name in names:
                raise ValueError(f"duplicate rule on line {line_number}")
            names.add(name)
            alternatives = []
            while True:
                literal, end = decoder.raw_decode(remaining)
                if not isinstance(literal, str):
                    raise ValueError(f"expected a JSON string literal on line {line_number}")
                literals.add(literal)
                alternatives.append({"items": [{"kind": "terminal", "literal": literal}]})
                remaining = remaining[end:].strip()
                if remaining in {"", ";"}:
                    break
                if not remaining.startswith("|"):
                    raise ValueError(f"unsupported syntax on line {line_number}")
                remaining = remaining[1:].lstrip()
            rules.append({"name": name, "alternatives": alternatives})
    if not rules:
        raise ValueError("expected at least one rule")
    return rules, sorted(literals)


def main():
    arguments = ProtocolArguments()
    arguments.add_argument("operation", choices=["parse"])
    arguments.add_argument("files", nargs="*")
    arguments.add_argument("--dialect")
    arguments.add_argument("--stdin", action="store_true")
    options = arguments.parse_args()
    if options.stdin == bool(options.files):
        arguments.error("provide source paths or --stdin, exclusively")
    sources = (
        [("<stdin>", sys.stdin.read())]
        if options.stdin
        else [(name, Path(name).read_text(encoding="utf-8")) for name in options.files]
    )
    rules, literals = parse_grammar(sources)
    ir = {
        "irVersion": "1.4.0",
        "source": {
            "format": "example-literals",
            "dialect": options.dialect or "literal-alternatives",
            "fileNames": [name for name, _ in sources],
            "frontend": {"id": "example-literals", "version": "0.1.0"},
        },
        "capabilities": {
            "orderedChoice": False,
            "ebnfSugar": False,
            "predicates": False,
            "scannerless": False,
            "precedenceTable": False,
            "parameterizedRules": False,
            "lexerRules": False,
        },
        "startSymbols": [rules[0]["name"]],
        "terminals": [{"literal": literal} for literal in literals],
        "externalSymbols": [],
        "precedence": [],
        "rules": rules,
        "diagnostics": [],
    }
    json.dump(ir, sys.stdout, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError) as error:
        print(f"external frontend: {error}", file=sys.stderr)
        sys.exit(2)
