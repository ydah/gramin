{
  "name": "@gramin/frontend-yacc",
  "version": "0.1.0",
  "author": "Yudai Takada",
  "description": "Yacc, Bison, and Lrama frontend for gramin",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@gramin/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
