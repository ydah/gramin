{
  "name": "@gramin/frontend-menhir",
  "version": "0.1.0",
  "author": "Yudai Takada",
  "description": "Menhir grammar frontend for gramin",
  "keywords": [
    "grammar",
    "parser",
    "menhir",
    "ocaml"
  ],
  "homepage": "https://github.com/ydah/gramin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydah/gramin.git",
    "directory": "packages/frontend-menhir"
  },
  "bugs": {
    "url": "https://github.com/ydah/gramin/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run src",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@gramin/core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
