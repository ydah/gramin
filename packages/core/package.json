{
  "name": "@gramin/core",
  "version": "0.1.0",
  "author": "Yudai Takada",
  "description": "Versioned Grammar IR and feature contracts for gramin",
  "keywords": [
    "grammar",
    "parser",
    "typescript",
    "json-schema"
  ],
  "homepage": "https://ydah.github.io/gramin/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydah/gramin.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ydah/gramin/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "schema",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "build": "tsc -b && node dist/write-schemas.js",
    "test": "vitest run src",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
